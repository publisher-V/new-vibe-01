{
  "name": "new-vibe-01",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Simple notepad with Cloudflare Pages Functions and D1",
  "scripts": {
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy .",
    "db:migrate:local": "wrangler d1 migrations apply new-vibe-01-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply new-vibe-01-notes --remote"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
